# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# Without these the game still runs; cloud saves simply stay hidden. (On Firebase Hosting the config is also read
# from /__/firebase/init.json automatically.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
