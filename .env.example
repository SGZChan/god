# Copy to .env.local for local testing; on Vercel add the same names under Project > Settings > Environment Variables.
# Without them the game still runs: saves stay in the browser (or a file) and the account option stays hidden.
# Both values are in Supabase: Project settings > API (the URL, and the "anon / publishable" key; both are public by design).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
# Which sign-in buttons to show: email (a magic link, works out of the box), google (needs Google enabled in Supabase), or both
VITE_SUPABASE_PROVIDERS=email
