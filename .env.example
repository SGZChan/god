# Copy to .env.local for local testing; on Vercel add the same names under Project > Settings > Environment Variables.
# Without them the game still runs: saves stay in the browser (or a file) and the account option stays hidden.
# Values: Firebase console > Project settings > Your apps > Web app (the config is public by design; firestore.rules protects the data).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
